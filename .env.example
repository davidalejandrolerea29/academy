# API Configuration
VITE_API_URL=http://localhost:8000/api/v1

# Vista previa local sin login (solo npm run dev; nunca en producción).
# Para activarla, agregar VITE_DEV_PREVIEW=true a .env.development.local.
VITE_DEV_PREVIEW=false

# Jitsi Configuration (optional - defaults to meet.jit.si if not set)
# VITE_JITSI_DOMAIN=meet.jit.si

# WebSocket Configuration (if needed)
# VITE_WS_URL=ws://127.0.0.1:8000

# Other environment variables
# Add any additional configuration here as needed
